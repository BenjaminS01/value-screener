# Copy this file to .env and fill in your own values. .env is gitignored.
#
# ADMIN_PASSWORD_HASH: generate with
#   cd backend
#   mvn -q spring-boot:run -Dspring-boot.run.main-class=com.valuescreener.security.AdminPasswordHashGenerator -Dspring-boot.run.arguments=<your-plaintext-password>
# Copy the printed bcrypt hash below (keep the $ characters, no extra quoting needed here).

ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Optional additional accounts with role USER (Spring relaxed binding, index 0, 1, ...).
# Usernames are case-insensitive and must be unique (also versus ADMIN_USERNAME); "*" is reserved.
# Hash the USER password with the same AdminPasswordHashGenerator as above.
# Password length (documentation only, a hash cannot be checked): ADMIN at least 20 characters, USER at least 16.
# Use long random passwords (bcrypt only uses the first 72 bytes).
# To add a user, uncomment BOTH lines and fill them (an empty entry is bound as a blank account and stops startup).
# The application refuses to start if a hash is not a valid bcrypt hash.
# APP_USERS_0_USERNAME=
# APP_USERS_0_PASSWORD_HASH=

# Machine token for the local research ingest (research-company skill in the sandbox).
# Generate token + hash (the token is shown once, only the hash goes here):
#   cd backend
#   mvn -q spring-boot:run -Dspring-boot.run.main-class=com.valuescreener.security.MachineTokenGenerator
# Put ONLY the sha256 value below. Export the plaintext token only in the shell that starts the sandbox:
#   export RESEARCH_INGEST_TOKEN='<token>'; ./docker/claude-sandbox/run.sh
# NOTE: the sandbox mounts the repo read-only but can still READ this .env. Hence .env holds hashes only,
# and a strong ADMIN password matters (the ADMIN hash is readable from the sandbox).
# The local profile (dev-up.sh) refuses to start without it. Never set it in AWS: there the endpoint must not exist.
APP_RESEARCH_INGEST_TOKEN_HASH=
